[Unit]
Description=Traffic Control Smart Shaping Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tcsss
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Capabilities instead of root (optional: use User=root if this fails)
# AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target
